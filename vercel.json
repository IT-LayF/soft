{
  "version": 2,
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/cabinet", "destination": "/cabinet.html"},
    {"source": "/admin", "destination": "/admin.html"}
  ],
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/(.*).html", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/cabinet", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/admin", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/app.css", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]}
  ]
}
